# ==============================================================================
# PayPal Developer Sandbox Credentials
# Get these from: https://developer.paypal.com/dashboard/applications/sandbox
# ==============================================================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# Optional Sandbox Test Accounts (from Developer Dashboard > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_BUYER_EMAIL=personal-buyer@example.com
PAYPAL_SANDBOX_SELLER_EMAIL=business-merchant@example.com

# ==============================================================================
# AI Model & Agent Credentials
# ==============================================================================
# Google Gemini API Key (Recommended default for tool-calling agent)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback if using LangChain / OpenAI Agents SDK)
OPENAI_API_KEY=your_openai_api_key_here

# ==============================================================================
# Application & Decision Engine Settings
# ==============================================================================
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Financial Safety Invariants (Defaults for "Buy or Wait?" Simulation)
DEFAULT_MINIMUM_SAFETY_BALANCE=500.00
DEFAULT_CURRENCY=USD
SIMULATION_HORIZON_DAYS=90

